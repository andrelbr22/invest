# Modelo para desenvolvimento local. Na Oracle, mantenha os valores reais em
# deployment/secrets/streamlit_secrets.toml. Nunca envie o arquivo preenchido ao GitHub.

DATABASE_URL = "postgresql://USUARIO:SENHA@postgres:5432/investment_engine"
DATABASE_ADMIN_URL = "postgresql://USUARIO:SENHA@postgres:5432/investment_engine"
APP_AUTH_REQUIRED = "true"
APP_OWNER_EMAILS = "seu-email@gmail.com"
SHOW_API_SELECTOR = "false"
EMBEDDED_API_ENABLED = "true"
GITHUB_ACTIONS_TOKEN = "TOKEN_FINE_GRAINED_COM_ACTIONS_WRITE"

[auth]
redirect_uri = "https://formacaodoinvestidor.com.br/oauth2callback"
cookie_secret = "GERE_UMA_CHAVE_ALEATORIA_LONGA"
client_id = "CLIENT_ID_DO_GOOGLE"
client_secret = "CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
