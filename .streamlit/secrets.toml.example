# Copie estes valores para Settings > Secrets no Streamlit Community Cloud.
# Nunca envie este arquivo preenchido para o GitHub.

# Use a URL com "-pooler" para o funcionamento normal do aplicativo.
DATABASE_URL = "postgresql://USUARIO:SENHA@HOST-POOLER/BANCO?sslmode=require"
# Use a URL direta, sem "-pooler", somente para atualizar a estrutura do banco.
DATABASE_ADMIN_URL = "postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"
APP_AUTH_REQUIRED = "true"
APP_ALLOWED_EMAILS = "seu-email@gmail.com"
SHOW_API_SELECTOR = "false"
EMBEDDED_API_ENABLED = "true"

[auth]
redirect_uri = "https://invest-klpbhuewpmzb7njdsmha4t.streamlit.app/oauth2callback"
cookie_secret = "GERE_UMA_CHAVE_ALEATORIA_LONGA"
client_id = "CLIENT_ID_DO_GOOGLE"
client_secret = "CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
