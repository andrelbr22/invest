# Copie para worker-location.env na VM1. O arquivo real é ignorado pelo Git.
FDI_WORKER_LOCATION=local
FDI_WORKER_SSH_HOST=10.0.0.20
FDI_WORKER_SSH_USER=ubuntu
FDI_WORKER_SSH_KEY=/home/ubuntu/.ssh/fdi-worker
FDI_WORKER_KNOWN_HOSTS=/home/ubuntu/.ssh/fdi-worker-known-hosts
FDI_WORKER_PROJECT_DIR=/home/ubuntu/invest
FDI_REMOTE_WORKER_NODE_ID=worker-02
# Opt-in separado. O timer nunca habilita o retorno automático sozinho e
# nunca devolve o processamento automaticamente para a VM2.
FDI_AUTO_FAILBACK_ENABLED=false
FDI_AUTO_FAILBACK_FAILURE_THRESHOLD=3
