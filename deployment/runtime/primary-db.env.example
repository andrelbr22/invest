# Copie para primary-db.env na VM1. O arquivo real é ignorado pelo Git.
# Use somente o IP PRIVADO da VNIC da VM1.
FDI_PRIVATE_DB_BIND=10.0.0.10
# IP PRIVADO da VNIC da VM2. Deve coincidir com FDI_WORKER_SSH_HOST.
FDI_PRIVATE_DB_VM2_IP=10.0.0.20
# Mude ambos para true somente depois de criar uma regra NSG/VCN reversível:
# origem exata = IP privado da VM2/32, destino = IP privado da VM1, TCP 5432.
FDI_PRIVATE_DB_NSG_RULE_CONFIRMED=false
FDI_PRIVATE_DB_EXPOSURE_APPROVED=false
