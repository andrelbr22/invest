# Copie para app_secrets.toml apenas no servidor. Nunca publique o arquivo real.
DATABASE_URL = "postgresql+psycopg://investment:SENHA_DO_POSTGRES@postgres:5432/investment_engine"
DATABASE_ADMIN_URL = "postgresql+psycopg://investment:SENHA_DO_POSTGRES@postgres:5432/investment_engine"
APP_AUTH_REQUIRED = "true"
APP_OWNER_EMAILS = "seu-email@gmail.com"
BACKTEST_CALLBACK_TOKEN = "USE_EXATAMENTE_A_MESMA_CHAVE_DO_GITHUB"
GITHUB_ACTIONS_TOKEN = "TOKEN_GITHUB_COM_PERMISSAO_ACTIONS"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USERNAME = "seu-remetente@gmail.com"
SMTP_PASSWORD = "SENHA_DE_APLICATIVO_DO_GOOGLE"
SMTP_FROM_EMAIL = "contato@formacaodoinvestidor.com.br"
SMTP_FROM_NAME = "Formação do Investidor"
SMTP_STARTTLS = true
# O histórico oficial IMA-B/IRF-M exige credenciais do ANBIMA Feed.
# Sem elas, a rotina permanece visível como indisponível e não usa ETFs como substituto.
ANBIMA_CLIENT_ID = ""
ANBIMA_CLIENT_SECRET = ""
ANBIMA_IMA_HISTORY_START_DATE = "2004-04-30"
ANBIMA_IMA_HISTORY_BATCH_DAYS = 90
PORTFOLIO_DIVIDEND_REFRESH_BATCH_ASSETS = 500

[auth]
redirect_uri = "https://formacaodoinvestidor.com.br/oauth2callback"
cookie_secret = "CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES"
client_id = "CLIENT_ID_DO_GOOGLE"
client_secret = "CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
